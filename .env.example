# 4clique Environment Configuration
# Mapbox public access token (get free token from https://mapbox.com)
VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# AWS Lambda Function URL (Python 3.11 Hydrologic Twin)
# Example: https://xxxxxxxxxxxxxxxxxxxxxxxxxxxx.lambda-url.ap-south-1.on.aws/
# For local testing, use the local runner: http://127.0.0.1:8000
VITE_AWS_LAMBDA_URL=http://127.0.0.1:8000
